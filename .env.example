# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# Required: path to your Obsidian vault root (the folder containing Trading/).
# Differs between local machine and VPS — set it per environment.
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Optional: override the config.yaml location.
# WEAVER_CONFIG_PATH=/path/to/config.yaml

# Future components will add keys here (FRED, etc.).
# FRED_API_KEY=your_key_here
